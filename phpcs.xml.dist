<?xml version="1.0"?>
<ruleset name="payFURL for WooCommerce">
	<description>WordPress and WooCommerce coding standards, PHP 8.1 and later.</description>

	<file>woocommerce-payfurl.php</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<arg name="colors"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress"/>
	<rule ref="WooCommerce-Core"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="payfurl-extension-for-woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="payfurl"/>
				<element value="wc_payfurl"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce's file names for its gateway classes (class-wc-payfurl-*.php), kept from 1.x. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>includes/payfurl-blocks-integration.php</exclude-pattern>
		<exclude-pattern>includes/class-payfurl-sdk.php</exclude-pattern>
	</rule>
</ruleset>
